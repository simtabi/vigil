# Generated build output. build/ keeps its tracked inputs (targets.txt,
# nfpm.yaml); everything else in it is generated, one folder per OS (see the
# Makefile and src/scripts/build-all.sh).
/build/*
!/build/targets.txt
!/build/nfpm.yaml
# GoReleaser's scratch dist (src/.goreleaser.yaml `dist:`).
/.cache/

# Output of the layout before the module moved into src/.
/vigil
/dist/
/out/
*.exe
*.dll
*.so
*.dylib

# Test / coverage
*.test
*.out
coverage.*

# Go workspace
go.work
go.work.sum

# Editor / OS
.idea/
.vscode/
.DS_Store

# Local runtime artifacts
*.log
/tmp/
